{
  "dataRequestId": "lookupmember",
  "type": "object",
  "webhook": {
    "version": "v3",
    "sendContext": true,
    "implementation": "external",
    "method": "POST",
    "environments": {
      "production": {
        "url": "https://YOUR-ACXD-API-URL/lookup_member",
        "headers": [
          {
            "key": "Content-Type",
            "value": "application/json",
            "dynamic": false,
            "required": false
          },
          {
            "key": "x-api-key",
            "value": "{ccg_s5_api_key:NLX.Secret}",
            "dynamic": false,
            "required": false
          }
        ]
      }
    }
  },
  "description": "Shared CRM lookup: membership number or the phone number on the account -> member (not yet verified).",
  "sensitive": false,
  "streamStateModifications": false,
  "requestSchema": {
    "type": "object",
    "properties": {
      "membership_number": {
        "type": "string",
        "isSensitive": false,
        "title": "",
        "description": "Membership number as said/typed (e.g. M-20481537). Leave empty if the caller gives a phone number."
      },
      "phone": {
        "type": "string",
        "isSensitive": false,
        "title": "",
        "description": "Phone number on the account, if the caller gives that instead of the membership number"
      }
    },
    "isSensitive": false,
    "title": "",
    "description": ""
  },
  "responseSchema": {
    "type": "object",
    "properties": {
      "found": {
        "type": "boolean",
        "isSensitive": false,
        "title": "",
        "description": "true or false"
      },
      "member_id": {
        "type": "string",
        "isSensitive": false,
        "title": "",
        "description": "Use in later calls"
      },
      "first_name": {
        "type": "string",
        "isSensitive": false,
        "title": "",
        "description": ""
      },
      "tier": {
        "type": "string",
        "isSensitive": false,
        "title": "",
        "description": "Basic, Plus or Premier"
      },
      "vehicle": {
        "type": "string",
        "isSensitive": false,
        "title": "",
        "description": "Vehicle on file, e.g. 2023 Honda CR-V"
      },
      "vehicle_plate": {
        "type": "string",
        "isSensitive": false,
        "title": "",
        "description": ""
      },
      "member_since": {
        "type": "string",
        "isSensitive": false,
        "title": "",
        "description": ""
      },
      "service_history": {
        "type": "array",
        "isSensitive": false,
        "title": "",
        "description": "Previous roadside services (date, service)",
        "items": {
          "type": "object",
          "isSensitive": false,
          "title": "",
          "description": ""
        }
      },
      "open_cases": {
        "type": "number",
        "isSensitive": false,
        "title": "",
        "description": ""
      }
    },
    "isSensitive": false,
    "title": "",
    "description": ""
  },
  "metadata": {
    "path": "",
    "tags": []
  }
}
