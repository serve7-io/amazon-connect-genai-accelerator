# Bow River Dental dev environment - generated by scripts/new-tenant.sh
tenant              = "bowriver-dental"
environment         = "dev"
region              = "ca-central-1"
cost_center         = "CC-SERVE7-DELIVERY"
owner               = "milos.jovanic@serve7.io"
data_classification = "internal" # fictional demo; a real clinic is health data: use "confidential" + prod profile

# 10-foundation
recording_retention_days = 90

# 20-connect-core
instance_alias      = "s7-bowriver-dental-000001"
kinesis_stream_mode = "PROVISIONED" # dev: 1 shard; use ON_DEMAND for prod

# 40-genai (bedrock_model_id / bedrock_resource_arns come from scripts/preflight.py)
enforce_guardrail_iam     = true
enable_invocation_logging = true
enable_agentic_tools      = true # AI agent with MCP CRM tools (demo data from demo-crm.json)

# 30-routing
routing_file       = "../../tenants/bowriver-dental/routing.yaml"
claim_phone_number = false # new accounts start with a 0 phone-number quota; request an increase, then set true
phone_country_code = "CA"
admin_users = [
  {
    username   = "bowriver-dental.admin"
    first_name = "Bow"
    last_name  = "Admin"
    email      = "milos.jovanic@serve7.io"
  }
]

# 50-observability
alarm_emails = ["milos.jovanic@serve7.io"]
