# Northwind Demo Inc dev environment - generated by scripts/new-tenant.sh
tenant              = "client-demo"
environment         = "dev"
region              = "ca-central-1"
cost_center         = "CC-SERVE7-DELIVERY"
owner               = "milos.jovanic@serve7.io"
data_classification = "internal"

# 10-foundation
recording_retention_days = 90

# 20-connect-core
instance_alias      = "s7-client-demo-646645"
kinesis_stream_mode = "PROVISIONED" # dev: 1 shard; use ON_DEMAND for prod

# 40-genai (bedrock_model_id / bedrock_resource_arns come from scripts/preflight.py)
enforce_guardrail_iam     = true
enable_invocation_logging = true
enable_agentic_tools      = false # turn on once the client's CRM tools are mapped

# 30-routing
routing_file       = "../../tenants/client-demo/routing.yaml"
claim_phone_number = false # new accounts start with a 0 phone-number quota; request an increase, then set true
phone_country_code = "CA"
admin_users = [
  {
    username   = "client-demo.admin"
    first_name = "Northwind"
    last_name  = "Admin"
    email      = "milos.jovanic@serve7.io"
  }
]

# 50-observability
alarm_emails = ["milos.jovanic@serve7.io"]
