# {{COMPANY}} PRODUCTION - generated by scripts/new-tenant.py --prod-account-id. Separate AWS account: {{PROD_ACCOUNT_ID}}.
# Deploys only through CI with the GitHub environment "{{TENANT}}-prod" (required reviewers), or locally with PROD_CONFIRM={{TENANT}}.
tenant              = "{{TENANT}}"
environment         = "prod"
region              = "{{REGION}}"
cost_center         = "{{COST_CENTER}}"
owner               = "{{OWNER_EMAIL}}"
data_classification = "confidential"

# 10-foundation - align with the client's records-retention policy (contract!)
recording_retention_days = 365

# 20-connect-core
instance_alias           = "{{PROD_ALIAS}}"
kinesis_stream_mode      = "ON_DEMAND"
identity_management_type = "SAML" # agents sign in through the client's IdP / IAM Identity Center; fixed at creation

# 40-genai
enforce_guardrail_iam     = true  # never false in prod (check-tenants.py enforces)
enable_invocation_logging = false # prompts/answers contain customer PII; enable only with the client's written approval
enable_agentic_tools      = false

# 30-routing
routing_file       = "../../tenants/{{TENANT}}/routing.yaml"
claim_phone_number = false # flip after number porting / quota approval
phone_country_code = "{{COUNTRY}}"
admin_users = [] # SAML users are provisioned from the IdP; add break-glass admins here only if the client requires them

# 50-observability
alarm_emails = ["{{OWNER_EMAIL}}"]
